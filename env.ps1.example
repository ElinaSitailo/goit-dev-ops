# Copy this file to env.ps1 and fill in real values.
# env.ps1 is gitignored and must never be committed.

$env:AWS_ACCESS_KEY_ID=""
$env:AWS_SECRET_ACCESS_KEY=""

# Terraform reads these same credentials for the aws-jenkins Jenkins credential
$env:TF_VAR_aws_access_key_id=$env:AWS_ACCESS_KEY_ID
$env:TF_VAR_aws_secret_access_key=$env:AWS_SECRET_ACCESS_KEY

$env:TF_VAR_database_password = ""
$env:TF_VAR_django_secret_key = ""
$env:TF_VAR_django_allowed_hosts = ""

# Jenkins
$env:TF_VAR_jenkins_admin_password = ""
$env:TF_VAR_jenkins_gitops_username = ""
$env:TF_VAR_jenkins_gitops_token = ""

# Argo CD
$env:TF_VAR_argocd_application_repo_url = "https://github.com/<org>/<gitops-repo>.git"
$env:TF_VAR_argocd_application_target_revision = "main"
$env:TF_VAR_argocd_application_path = "charts/django-app"
$env:TF_VAR_argocd_application_destination_namespace = "default"
$env:TF_VAR_argocd_server_service_name = "argocd-server"

$env:ECR_REPOSITORY_URL="<account_id>.dkr.ecr.eu-north-1.amazonaws.com/lesson-5-ecr"

# RDS
# Set use_aurora=true to deploy Aurora MySQL, false for standard RDS MySQL
$env:TF_VAR_rds_use_aurora = "false"
# Override engine/version pair when switching between MySQL and Aurora MySQL:
#   Standard RDS MySQL:  engine=mysql,         engine_version=8.0
#   Aurora MySQL:        engine=aurora-mysql,   engine_version=8.0.mysql_aurora.3.07.1
$env:TF_VAR_rds_engine         = "mysql"
$env:TF_VAR_rds_engine_version = "8.0"
$env:TF_VAR_rds_instance_class = "db.t3.micro"
$env:TF_VAR_rds_multi_az       = "false"

# Monitoring (Prometheus + Grafana)
$env:TF_VAR_monitoring_grafana_admin_password = ""
