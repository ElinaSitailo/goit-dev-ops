# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
#
# Usage:
#   source .env
#   terraform apply
#   bash deploy.sh

# Terraform reads these automatically via TF_VAR_ prefix
export TF_VAR_database_password=
export TF_VAR_django_allowed_hosts=
export TF_VAR_jenkins_admin_password=
export TF_VAR_argocd_application_repo_url=https://github.com/<org>/<gitops-repo>.git
export TF_VAR_argocd_application_target_revision=main
export TF_VAR_argocd_application_path=charts/django-app
export TF_VAR_argocd_application_destination_namespace=default
export TF_VAR_argocd_server_service_name=argocd-server

# ECR image URL — get from: terraform output ecr_repository_url
export ECR_REPOSITORY_URL=
